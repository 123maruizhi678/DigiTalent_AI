# 应用基础配置（均非必填、非敏感，省略时使用默认值）
# APP_NAME 应用名称：FastAPI 标题；非空字符串；默认 DigiTalent AI。
APP_NAME="DigiTalent AI"
# APP_ENV 运行环境：development/test/production；字符串；默认 development。
APP_ENV=development
# DEBUG 调试模式：布尔值 true/false、1/0、yes/no、on/off；默认 false。
DEBUG=false
# API_V1_PREFIX API 前缀：挂载总路由；字符串，仅允许 /api/v1；默认 /api/v1；非必填、非敏感，所有环境保持一致。
API_V1_PREFIX=/api/v1
# HOST 监听地址：非空字符串，有效主机名或 IP；默认 127.0.0.1；用于 python -m app.main。
HOST=127.0.0.1
# PORT 监听端口：整数 1～65535；默认 8080；用于 python -m app.main。
PORT=8080

# 日志配置（均非必填、非敏感，本任务不初始化日志设施）
# LOG_LEVEL 日志级别：DEBUG/INFO/WARNING/ERROR/CRITICAL，大小写不敏感；字符串；默认 INFO。
LOG_LEVEL=INFO
# LOG_OUTPUT 日志输出方式：字符串，仅允许 console；默认 console，不写日志目录。
LOG_OUTPUT=console

# 后续外部服务配置分类（仅预留，不要求凭据，不创建连接）
# MySQL 数据库：后续使用受保护的敏感字段定义连接凭据。
# Milvus 向量服务：对应任务定义连接与认证配置。
# Ollama 模型服务：对应任务定义服务地址与模型配置。
# MinerU 文档解析：对应任务定义服务配置。
# 文件存储：对应任务定义路径和存储凭据。
# 模型服务：对应任务定义供应商、模型及受保护的 API Key。
# 任务调度：对应任务定义调度参数。

# MySQL 配置（均非必填；用户名和库名为空时数据库检查报告未配置）
# MYSQL_HOST 主机地址；非空主机名或 IP；类型 str；默认127.0.0.1；非必填、非敏感。
MYSQL_HOST=127.0.0.1
# MYSQL_PORT 端口；整数 1～65535；类型 int；默认3306；非必填、非敏感。
MYSQL_PORT=3306
# MYSQL_USER 用户名；字符串，空值表示未配置；类型 str；默认空字符串；非必填、非敏感。
MYSQL_USER=
# MYSQL_PASSWORD 密码；字符串，可为空，敏感且脱敏；类型 SecretStr；默认空字符串；非必填、敏感，请仅在本地设置真实值。
MYSQL_PASSWORD=
# MYSQL_DATABASE 数据库名；字符串，空值表示未配置；类型 str；默认空字符串；非必填、非敏感。
MYSQL_DATABASE=
# MYSQL_POOL_SIZE 基础连接数；整数 1～100；类型 int；默认5；非必填、非敏感。
MYSQL_POOL_SIZE=5
# MYSQL_MAX_OVERFLOW 额外连接数；整数 0～100；类型 int；默认10；非必填、非敏感。
MYSQL_MAX_OVERFLOW=10
# MYSQL_POOL_TIMEOUT 获取连接等待秒数；整数 1～300；类型 int；默认30；非必填、非敏感。
MYSQL_POOL_TIMEOUT=30
# MYSQL_POOL_RECYCLE 连接回收秒数；整数 1～86400；类型 int；默认1800；非必填、非敏感。
MYSQL_POOL_RECYCLE=1800
# MYSQL_CONNECT_TIMEOUT 建立连接超时秒数；整数 1～60；类型 int；默认5；非必填、非敏感。
MYSQL_CONNECT_TIMEOUT=5
